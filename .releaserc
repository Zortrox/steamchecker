{
  "branches": [
    "main",
    {
      "name": "beta",
      "prerelease": true
    }
  ],
  "plugins": [
    [
      "@semantic-release/commit-analyzer",
      {
        "preset": "angular",
        "releaseRules": [
          {
            "type": "major",
            "release": "major"
          },
          {
            "type": "minor",
            "release": "minor"
          },
          {
            "type": "patch",
            "release": "patch"
          },
          {
            "type": "style",
            "release": "patch"
          },
          {
            "type": "refactor",
            "release": "patch"
          },
          {
            "type": "perf",
            "release": "patch"
          }
        ]
      }
    ],
    [
      "@semantic-release/release-notes-generator",
      {
        "preset": "conventionalcommits",
        "presetConfig": {
          "types": [
            {
              "type": "feat",
              "section": "🎉 Features",
              "hidden": false
            },
            {
              "type": "fix",
              "section": "🐛 Bug Fixes",
              "hidden": false
            },
            {
              "type": "docs",
              "section": "📖 Documentation",
              "hidden": false
            },
            {
              "type": "style",
              "section": "✒️ Style Changes",
              "hidden": false
            },
            {
              "type": "refactor",
              "section": "🔃 Refactor",
              "hidden": false
            },
            {
              "type": "perf",
              "section": "📈 Performance Improvements",
              "hidden": false
            },
            {
              "type": "test",
              "section": "🔧 Tests",
              "hidden": false
            },
            {
              "type": "ci",
              "section": "🖥️ CI/CD",
              "hidden": false
            },
            {
              "type": "chore",
              "hidden": true
            }
          ]
        }
      }
    ],
    "@semantic-release/npm",
    [
      "@semantic-release/exec",
      {
        "prepareCmd": "bun run build && bun run package:source",
        "successCmd": "echo \"version=${nextRelease.version}\" >> \"$GITHUB_OUTPUT\" && echo \"channel=${nextRelease.channel || 'latest'}\" >> \"$GITHUB_OUTPUT\""
      }
    ],
    [
      "@semantic-release/github",
      {
        "assets": [
          {
            "path": "extension-chrome.zip",
            "label": "Chrome Extension",
            "name": "steamchecker-chrome.zip"
          },
          {
            "path": "extension-firefox.zip",
            "label": "Firefox Extension",
            "name": "steamchecker-firefox.zip"
          },
          {
            "path": "extension-source.zip",
            "label": "Source code (for AMO review)",
            "name": "steamchecker-source.zip"
          }
        ]
      }
    ]
  ]
}
