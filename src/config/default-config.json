{
  "schema_version": 2,
  "revision": "2026-11-27-store-pages",
  "pages": [
    {
      "id": "library",
      "path": "^/home/library/?$",
      "targets": [
        {
          "id": "library-purchased",
          "game_wrapper": "a[href^=\"/home/library/content/\"]",
          "title": ".text-accent",
          "require": "[aria-label=\"Steam\"]",
          "badge": ":scope",
          "class_type": "LibraryRow"
        }
      ]
    },
    {
      "id": "library-bundle",
      "path": "^/home/library/[0-9a-f]{8}-[0-9a-f-]{27}/?$",
      "targets": [
        {
          "id": "library-bundle-keys",
          "game_wrapper": ".bg-card:has([data-testid=\"platform-icons\"])",
          "title": ".text-accent",
          "require": "[aria-label=\"Steam\"]",
          "badge": ":scope",
          "class_type": "LibraryRow"
        }
      ]
    },
    {
      "id": "bundle",
      "path": "^/(games|software|books)/[^/]+",
      "targets": [
        {
          "id": "bundle-items",
          "game_wrapper": "[data-testid=\"bundle-item-card\"]",
          "title": "[data-testid=\"product-thumbnail\"] img",
          "title_attribute": "alt",
          "require": "[aria-label=\"Steam\"]",
          "badge": "[data-testid=\"product-thumbnail\"]",
          "class_type": "Card"
        }
      ]
    },
    {
      "id": "membership",
      "path": "^/membership",
      "targets": [
        {
          "id": "membership-items",
          "game_wrapper": "[data-testid=\"bundle-item-card\"]",
          "title": "[data-testid=\"product-thumbnail\"] img",
          "title_attribute": "alt",
          "badge": "[data-testid=\"product-thumbnail\"]",
          "class_type": "Card"
        },
        {
          "id": "membership-product-cards",
          "game_wrapper": "[data-testid=\"product-card\"]",
          "title": "[data-testid=\"product-card-footer\"] [data-testid=\"product-link\"]",
          "require": "a[href^=\"/store/\"]",
          "badge": "[data-testid=\"product-thumbnail\"]",
          "class_type": "Card"
        }
      ]
    },
    {
      "id": "home-and-store",
      "path": "^/(store(/|$)|(on-sale|bestselling|new-releases|pre-order|books-store|software-store|deals-under-(5|10)|great-on-handhelds|rpg|virtual-reality|simulation|strategy|action|adventure|indie|racing|all-genres|windows|nintendo-switch(-2)?|steam|mac|linux|all-platforms)/?$|$)",
      "targets": [
        {
          "id": "store-product-cards",
          "game_wrapper": "[data-testid=\"product-card\"]",
          "title": "[data-testid=\"product-card-footer\"] [data-testid=\"product-link\"] > div > div > div:not([data-testid])",
          "require": "a[href^=\"/store/\"]",
          "badge": "[data-testid=\"product-thumbnail\"]",
          "class_type": "Card"
        }
      ]
    },
    {
      "id": "keys-legacy",
      "path": "^/home/keys",
      "targets": [
        {
          "id": "keys-table",
          "game_wrapper": ".unredeemed-keys-table tr",
          "title": ".game-name h4",
          "badge": ".hb-gift",
          "class_type": "Key"
        }
      ]
    }
  ]
}
